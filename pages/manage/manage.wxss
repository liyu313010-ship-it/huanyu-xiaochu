.page-header { padding: 48rpx 32rpx 24rpx; }
.page-title { font-size: 44rpx; font-weight: bold; color: #3D2B1F; display: block; }
.page-sub { font-size: 26rpx; color: #8B6F5E; display: block; margin-top: 8rpx; }
.add-section {
  margin: 0 32rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(61,43,31,0.08);
}
.section-title { font-size: 30rpx; font-weight: bold; color: #3D2B1F; display: block; margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; color: #8B6F5E; margin-bottom: 12rpx; margin-top: 24rpx; }
.emoji-scroll { margin-bottom: 4rpx; white-space: nowrap; }
.emoji-list { display: flex; padding: 4rpx 0; }
.emoji-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #F5EDE8;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  border: 3rpx solid transparent;
  margin-right: 12rpx;
}
.emoji-item.active { border-color: #E8956D; background: #FFF0E8; }
.input-field {
  width: 100%;
  height: 88rpx;
  background: #FFF8F4;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3D2B1F;
  border: 2rpx solid #F0E4DC;
  box-sizing: border-box;
}
.cat-list { display: flex; flex-wrap: wrap; }
.cat-tag {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #F0E4DC;
  color: #8B6F5E;
  border: 2rpx solid transparent;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.cat-tag.active { background: #E8956D; color: #FFFFFF; border-color: #E8956D; }
.add-btn {
  margin-top: 32rpx;
  background: #E8956D;
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(232,149,109,0.35);
}
.list-section { padding: 0 32rpx 40rpx; }
.manage-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(61,43,31,0.06);
}
.manage-emoji { font-size: 52rpx; margin-right: 20rpx; flex-shrink: 0; }
.manage-info { flex: 1; min-width: 0; }
.manage-name { font-size: 30rpx; font-weight: bold; color: #3D2B1F; display: block; }
.manage-label { display: inline-block; margin-top: 8rpx; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.delete-btn {
  padding: 12rpx 28rpx;
  background: #FFF0EE;
  color: #C43A3A;
  border-radius: 32rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}
